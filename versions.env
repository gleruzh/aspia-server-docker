# The Aspia release this repository packages: the single source of the version.
# The Dockerfile, tests/run.sh and the workflows read it from here. Change it only with
#   scripts/versions.sh bump <version> <router sha256> <relay sha256>
# which also updates every pinned image tag; scripts/versions.sh check verifies them.
#
# Upstream publishes no checksums for the Linux packages. These are the sha256 of the release
# assets aspia-router-<version>-x86_64.deb and aspia-relay-<version>-x86_64.deb, checked against
# the digest the GitHub API reports for them when they were added.
ASPIA_VERSION=3.0.26
ASPIA_ROUTER_SHA256=832d489feea257275f4ef8c38023bacebc636940b815946d5624642e0a44f63e
ASPIA_RELAY_SHA256=beb788d0706ad4d323586b1390e5f325597205de44ce23c62833d631fdfeb5b1
