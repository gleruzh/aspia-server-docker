#!/bin/bash
#
# aspia_start: entrypoint of the Aspia Server image (Aspia Router and Aspia Relay in one container).
#
# ASPIA_ROLE selects what runs: all (the default: the Router and its own Relay, exactly as before
# the variable existed), router (only the Router; Relays connect from other machines), or relay
# (only a Relay, connected to a Router on another machine: ASPIA_RELAY_ROUTER_ADDRESS,
# ASPIA_RELAY_ROUTER_PORT, ASPIA_RELAY_ROUTER_PUBLIC_KEY or ..._FILE). Every phase below runs only
# for the processes of the role (SERVICES).
#
#   1. Check the settings and the data on the volumes. Nothing is changed if a check fails.
#   2. Prepare the configuration:
#        - empty volumes:  create it with the binaries' own --create-config (the Router writes a
#                          random password for 'admin'; it is saved in /etc/aspia/initial-admin-password);
#        - 3.x data:       leave it alone.
#      Aspia 2.x data (router.json, relay.json) is refused in phase 1: Aspia 3.1 does not convert
#      it. Start the last 2.x-compatible image (LAST_2X_IMAGE) on it once first.
#      Then apply every ASPIA_ROUTER_*/ASPIA_RELAY_* variable that is set (EXTERNAL_IP is kept as
#      an alias of ASPIA_RELAY_PUBLIC_ADDRESS) into the Router/Relay configuration. A variable that
#      is set is written on every start; a variable that is unset leaves the file as it is, so a
#      hand edit survives. A file is only rewritten if a value actually changes.
#   3. Start the processes, forward SIGTERM/SIGINT to them, and exit non-zero if one of them dies.
#
# Based on server/aspia_start from SinitsaDA/aspia-server-docker (commit de15b99, GPL-3.0),
# https://github.com/SinitsaDA/aspia-server-docker. Ported: filling relay.conf router/public_key
# from the Router key, the awk INI editing, and the wait -n supervision with signal forwarding.
# Changed: EXTERNAL_IP is required, backups before a change, no sleep before starting the Relay, and the
# configuration files are rewritten atomically. PR 3 added: an ASPIA_ROUTER_*/ASPIA_RELAY_*
# variable scheme for every documented router.conf/relay.conf key (ports, allow-lists, STUN,
# Relay timeout/limit), stricter address/port/list validation, EXTERNAL_IP=auto (detected over
# HTTPS, now with openssl s_client: the image has no curl), and PUID/PGID to run both processes as
# non-root.
# PR 5 added ASPIA_ROLE and the ASPIA_RELAY_ROUTER_* variables for a Relay on its own.

# SC2329: validate_*, prepare_*, start_* and print_summary_* are called by name through SERVICES, on_signal by trap.
# shellcheck disable=SC2329

set -euo pipefail

# The volumes hold private keys and the user database: every file this script and the Aspia
# processes create (configuration, keys, the database and its journal files, backups) is readable
# by its owner only. restrict_permissions fixes the files of older starts.
umask 0077

# shellcheck source=aspia_common.sh
source /usr/lib/aspia-server/aspia_common.sh

readonly CONFIG_DIR=/etc/aspia
readonly DATA_DIR=/var/lib/aspia
readonly ROUTER_CONF="${CONFIG_DIR}/router.conf"
readonly RELAY_CONF="${CONFIG_DIR}/relay.conf"
readonly HOST_PUB="${CONFIG_DIR}/host.pub"      # 3.x: the key hosts are configured with
readonly RELAY_PUB="${CONFIG_DIR}/relay.pub"    # 3.x: the key relays authenticate the Router with
readonly ROUTER_DB="${DATA_DIR}/router.db3"
readonly ROUTER_JSON="${CONFIG_DIR}/router.json" # 2.x data; 3.0.x renames it to router.json.bak once converted
readonly RELAY_JSON="${CONFIG_DIR}/relay.json"   # 2.x data; likewise relay.json.bak
readonly ROUTER_PUB="${CONFIG_DIR}/router.pub"   # only checked for, so that a lost volume is not replaced by new keys
# Where a new Router's random password for 'admin' is saved (root only; the user deletes it after the first login).
readonly ADMIN_PASSWORD_FILE="${CONFIG_DIR}/initial-admin-password"

# The last image that reads Aspia 2.x data and has the 2.x host port; it converts the data to 3.x.
readonly LAST_2X_IMAGE=ghcr.io/gleruzh/aspia-server:3.0.37

# How long to wait for a started process to open its port before moving on.
readonly LISTEN_TIMEOUT_SECONDS=60

# The processes this container runs, in start order, set from ROLE (ASPIA_ROLE, defaulted in
# aspia_common.sh) by resolve_role through role_services, which aspia_health uses too. This is the
# only place that decides it: every phase below runs validate_<name>, prepare_<name> and
# start_<name> for each entry.
SERVICES=()

# IPv6 literal, without zone id: https://stackoverflow.com/questions/53497 (public domain snippet).
readonly RE_IPV6='^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$'

# Sources for ASPIA_RELAY_PUBLIC_ADDRESS=auto, tried in order. Plain, well-known "what is my IP"
# endpoints (the same ones SinitsaDA/aspia-server-docker used), each given a short timeout.
readonly AUTO_ADDRESS_SOURCES=("https://api.ipify.org" "https://ifconfig.me/ip" "https://icanhazip.com")
readonly AUTO_ADDRESS_TIMEOUT=5
# The CA bundle of the ca-certificates package; the answer is used only from a verified source.
readonly AUTO_ADDRESS_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# IPv4 ranges that an auto-detected address is never in: such an answer is not the address clients
# and hosts can reach (a proxy, a broken source). "<subnet> <what it is>"; IPv6 is in auto_address_rejected.
readonly AUTO_ADDRESS_REJECTED_IPV4=(
    "0.0.0.0/8 an unspecified address"
    "10.0.0.0/8 a private address (RFC 1918)"
    "100.64.0.0/10 a carrier-grade NAT address (RFC 6598)"
    "127.0.0.0/8 a loopback address"
    "169.254.0.0/16 a link-local address"
    "172.16.0.0/12 a private address (RFC 1918)"
    "192.0.2.0/24 a documentation address (RFC 5737)"
    "192.168.0.0/16 a private address (RFC 1918)"
    "198.51.100.0/24 a documentation address (RFC 5737)"
    "203.0.113.0/24 a documentation address (RFC 5737)"
    "224.0.0.0/4 a multicast address"
    "255.255.255.255/32 the broadcast address"
    "240.0.0.0/4 a reserved address (240.0.0.0/4)"
)

BACKUP_SUFFIX=".pre-${ASPIA_VERSION:-3.x}-$(date -u +%Y%m%dT%H%M%SZ)"
readonly BACKUP_SUFFIX

ROUTER_STATE=""   # new | existing
RELAY_STATE=""    # new | existing
PEER_PUBLIC_ADDRESS=""   # resolved in validate_relay: ASPIA_RELAY_PUBLIC_ADDRESS, its alias
                          # EXTERNAL_IP, or the result of "auto" detection.
DETECTED_ADDRESS=""      # set by detect_public_address
ROUTER_KEY=""            # The Router's relay key that relay.conf gets. Remote Router (ASPIA_ROLE=relay): resolved
                          # in validate_remote_relay from ASPIA_RELAY_ROUTER_PUBLIC_KEY or the file
                          # ASPIA_RELAY_ROUTER_PUBLIC_KEY_FILE. Otherwise read from relay.pub in prepare_relay
                          # (a new install has no relay.pub before prepare_router has run).

declare -A CHILDREN=()   # pid -> process name
CHILD_SETPRIV=()         # setpriv options for the Aspia processes, set by child_privileges
declare -A BACKED_UP=()  # file -> 1 once copied (or created) in this start; backup() skips it
STOPPING=0
EXIT_CODE=0
STARTED_PID=""

# Everything goes to stderr, like the Aspia log (ASPIA_LOG_TO_STDOUT writes to stderr), so that
# docker logs keeps the entrypoint's lines and the processes' lines in one order.
log() { printf '[aspia_start] %s\n' "$*" >&2; }
warn() { printf '[aspia_start] WARNING: %s\n' "$*" >&2; }
die() {
    printf '[aspia_start] ERROR: %s\n' "$*" >&2
    exit 1
}

# ---------------------------------------------------------------------------------------------
# Helpers

# replace_file <file> <new content file>: atomically replaces <file>, keeping its owner. Only the
# configuration files are rewritten (router.conf holds the private keys): mode 0600.
replace_file() {
    chmod 0600 -- "$2"
    chown -h --reference="$1" -- "$2"
    mv -f -- "$2" "$1"
}

# copy_file <src> <dest> [mode]: cp -a without CAP_FOWNER (mode first, then owner), but with
# <mode>, by default 0600: the copies are backups of the configuration and the database, and keys.
# The mode is set while root still owns the copy: after the chown, root could not change it any
# more on files of another uid. Never writes through a symbolic link at <dest>.
copy_file() {
    cp --preserve=timestamps --remove-destination -- "$1" "$2"
    chmod "${3:-0600}" -- "$2"
    chown -h --reference="$1" -- "$2"
}

# ini_set <file> <section> <key> <value>: sets one key; the rest of the file is kept as it is.
# The caller validates <value> (no newlines, no backslashes).
ini_set() {
    local tmp
    tmp="$(mktemp "$1.XXXXXX")"
    awk -v section="$2" -v key="$3" -v value="$4" '
        function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
        { line = $0; sub(/\r$/, "", line) }
        line ~ /^[ \t]*\[/ {
            if (in_section && !done) { print key "=" value; done = 1 }
            in_section = (trim(line) == "[" section "]")
            print; next
        }
        in_section && !done && (p = index(line, "=")) > 0 && trim(substr(line, 1, p - 1)) == key {
            print key "=" value; done = 1; next
        }
        { print }
        END {
            if (!done) {
                if (!in_section) { print ""; print "[" section "]" }
                print key "=" value
            }
        }
    ' "$1" > "${tmp}" || { rm -f "${tmp}"; die "cannot update $1"; }
    replace_file "$1" "${tmp}"
}

# backup <file>...: copies each existing, non-empty file next to itself as <file>${BACKUP_SUFFIX},
# once per start: the first copy holds the content from before this start changed anything. An
# existing copy of that name (another start in the same second) is never overwritten; the new copy
# gets a numbered name instead.
backup() {
    local file dest n
    for file in "$@"; do
        [[ -s "${file}" && -z "${BACKED_UP[${file}]:-}" ]] || continue
        dest="${file}${BACKUP_SUFFIX}"
        for ((n = 1; ; n++)); do
            [[ -e "${dest}" ]] || break
            dest="${file}${BACKUP_SUFFIX}.${n}"
        done
        copy_file "${file}" "${dest}"
        BACKED_UP[${file}]=1
        log "Backup: ${file} -> ${dest}"
    done
}

# read_key <file>: prints the key in <file> if it is 64 hex characters, otherwise nothing.
read_key() {
    local key=""
    [[ -s "$1" ]] && key="$(tr -d '[:space:]' < "$1")"
    [[ "${key}" =~ ^[0-9A-Fa-f]{64}$ ]] && printf '%s\n' "${key}"
    return 0
}

# cap_eff: this process's effective capabilities, the hex mask of /proc/<pid>/status.
# has_cap <number>: the capability with that number (linux/capability.h) is in that set.
readonly CAP_DAC_OVERRIDE=1 CAP_SETPCAP=8
cap_eff() { awk '/^CapEff:/ { print $2 }' "/proc/$$/status"; }
has_cap() { (( (16#$(cap_eff) >> $1) & 1 )); }

# set_conf_value <file> <section> <key> <value> <label>: like ini_set, but only touches the file
# (with a backup first) when the value actually changes, and logs what it did.
set_conf_value() {
    local file="$1" section="$2" key="$3" value="$4" label="$5" current
    current="$(ini_get "${file}" "${section}" "${key}" "")"
    if [[ "${current}" != "${value}" ]]; then
        backup "${file}"
        ini_set "${file}" "${section}" "${key}" "${value}"
        log "${label}: set [${section}] ${key}=${value} (was '${current}')."
    fi
}

# trim <string>: strips leading and trailing whitespace.
trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "${s}"
}

# ---------------------------------------------------------------------------------------------
# Validation helpers for ASPIA_ROUTER_*/ASPIA_RELAY_* variables. Each one is a no-op when the
# named variable is unset or empty (the "leave the file alone" case); an invalid value is a fatal
# error naming the variable, so nothing starts on a typo.

is_valid_ipv4() {
    local ip="$1" o
    [[ "${ip}" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]] || return 1
    local -a parts
    IFS=. read -ra parts <<<"${ip}"
    for o in "${parts[@]}"; do
        [[ "${o}" == 0 || "${o}" != 0* ]] || return 1   # reject a leading zero (ambiguous, and Qt rejects it)
        ((10#${o} <= 255)) || return 1
    done
}

is_valid_ipv6() { [[ "$1" =~ ${RE_IPV6} ]]; }

is_valid_ip() { is_valid_ipv4 "$1" || is_valid_ipv6 "$1"; }

# is_valid_hostname <name> [max length]: matches the Router's own isValidHostName (notes section
# 13.1): not empty, at most 64 characters (or [max length]), only letters, digits, '.', '_' and '-',
# at least one letter or digit.
is_valid_hostname() {
    local h="$1" max="${2:-64}"
    ((${#h} >= 1 && ${#h} <= max)) || return 1
    [[ "${h}" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
    [[ "${h}" =~ [A-Za-z0-9] ]] || return 1
}

# is_valid_address: what peer/public_address accepts (notes section 13.1): an IP literal or a
# host name. No DNS lookup is done, on either side.
is_valid_address() { is_valid_ip "$1" || is_valid_hostname "$1"; }

is_valid_ip_or_cidr() {
    local val="$1" addr prefix
    if [[ "${val}" == */* ]]; then
        addr="${val%%/*}"
        prefix="${val#*/}"
        [[ "${prefix}" =~ ^[0-9]+$ ]] || return 1
        if is_valid_ipv4 "${addr}"; then
            ((10#${prefix} <= 32)) || return 1
        elif is_valid_ipv6 "${addr}"; then
            ((10#${prefix} <= 128)) || return 1
        else
            return 1
        fi
    else
        is_valid_ip "${val}" || return 1
    fi
}

# ipv4_to_int <a.b.c.d>: the address as one 32-bit number, for CIDR containment arithmetic.
ipv4_to_int() {
    local a b c d
    IFS=. read -r a b c d <<<"$1"
    echo $(( (10#${a} << 24) | (10#${b} << 16) | (10#${c} << 8) | 10#${d} ))
}

# ipv4_in_subnet <address as a number (ipv4_to_int)> <subnet a.b.c.d> <prefix length>: succeeds if the
# address is in the subnet.
ipv4_in_subnet() {
    local mask=$(( (0xFFFFFFFF << (32 - 10#$3)) & 0xFFFFFFFF ))
    (( ($(ipv4_to_int "$2") & mask) == ($1 & mask) ))
}

# allowed_ips_covers_ipv4 <list> <ipv4>: true if the comma-separated allow-list (already validated
# by require_allowed_ips) contains <ipv4> itself or a CIDR subnet it falls in. IPv6 entries never
# match an IPv4 target (this image has no IPv6-mapped loopback case to cover).
allowed_ips_covers_ipv4() {
    local list="$1" target="$2" entry addr prefix
    local target_int
    target_int="$(ipv4_to_int "${target}")"
    local -a entries
    IFS=',' read -ra entries <<<"${list}"
    for entry in "${entries[@]}"; do
        entry="$(trim "${entry}")"
        if [[ "${entry}" == */* ]]; then
            addr="${entry%%/*}"
            prefix="${entry#*/}"
            is_valid_ipv4 "${addr}" || continue
            ((10#${prefix} == 0)) && return 0
            ipv4_in_subnet "${target_int}" "${addr}" "${prefix}" && return 0
        elif [[ "${entry}" == "${target}" ]]; then
            return 0
        fi
    done
    return 1
}

# require_port <VAR>: 1-65535, decimal (a leading zero is still decimal, as the Aspia binaries read it).
require_port() {
    local name="$1" value="${!1:-}"
    [[ -z "${value}" ]] && return 0
    if ! [[ "${value}" =~ ^[0-9]+$ ]] || ! ((10#${value} >= 1 && 10#${value} <= 65535)); then
        die "${name}='${value}' is not a valid port: it must be a number from 1 to 65535."
    fi
}

require_bool() {
    local name="$1" value="${!1:-}"
    [[ -z "${value}" ]] && return 0
    case "${value,,}" in
        0 | 1 | true | false) return 0 ;;
    esac
    die "${name}='${value}' must be 0, 1, true or false."
}

# require_minutes <VAR>: relay peer/idle_timeout is minutes; upstream places no documented upper
# bound, this is only a sanity limit against an obvious typo (525600 minutes = 1 year).
require_minutes() {
    local name="$1" value="${!1:-}"
    [[ -z "${value}" ]] && return 0
    if ! [[ "${value}" =~ ^[0-9]+$ ]] || ! ((10#${value} >= 1 && 10#${value} <= 525600)); then
        die "${name}='${value}' must be a number of minutes from 1 to 525600."
    fi
}

# require_count <VAR>: relay peer/max_count; same reasoning as require_minutes for the bound.
require_count() {
    local name="$1" value="${!1:-}"
    [[ -z "${value}" ]] && return 0
    if ! [[ "${value}" =~ ^[0-9]+$ ]] || ! ((10#${value} >= 1 && 10#${value} <= 1000000)); then
        die "${name}='${value}' must be a number from 1 to 1000000."
    fi
}

# require_allowed_ips <VAR>: a comma-separated list of IPs or CIDR subnets (router.conf white_list
# keys, notes section 4). Same rule as every other variable: an empty value ("VAR=") is treated the
# same as unset, so the file is left alone -- it does NOT clear an existing list (an empty
# white_list in router.conf itself still means "allow all"; to actually clear one, edit the file,
# or set the variable to the list you want).
require_allowed_ips() {
    local name="$1" value="${!1:-}" entry
    [[ -z "${value}" ]] && return 0
    local -a entries
    IFS=',' read -ra entries <<<"${value}"
    for entry in "${entries[@]}"; do
        entry="$(trim "${entry}")"
        [[ -n "${entry}" ]] || die "${name}='${value}' has an empty entry (a stray or trailing comma)."
        is_valid_ip_or_cidr "${entry}" || die "${name}='${value}': '${entry}' is not an IP address or a CIDR subnet."
    done
}

# refuse_path_override <VAR> <path this image still uses instead>: ASPIA_ROUTER_CONFIG_FILE,
# ASPIA_ROUTER_DB_FILE and ASPIA_RELAY_CONFIG_FILE are read by the Aspia binaries themselves (notes
# section 13.8) to move router.conf, router.db3 and relay.conf. This image's scripts still use the
# fixed paths above; if one of these is set, they would validate and edit the wrong file. Refuse
# rather than misbehave (docs/dev/FOLLOWUPS.md, "Path overrides").
refuse_path_override() {
    local name="$1" value="${!1:-}" fixed_path="$2"
    [[ -z "${value}" ]] && return 0
    die "${name}='${value}' is set. This image's scripts do not yet support moving that file" \
        "(they still read and write ${fixed_path} directly); aspia_start and aspia_health would" \
        "check the wrong path. Unset ${name}. Nothing was changed."
}

# ipv6_expand <ipv6>: prints the address with all eight groups, four lower-case hex digits each
# (2001:db8::1 -> 2001:0db8:0000:0000:0000:0000:0000:0001). The address must be valid (is_valid_ipv6).
ipv6_expand() {
    local ip="${1,,}" group out=""
    local -a head=() tail=()
    if [[ "${ip}" == *::* ]]; then
        IFS=: read -ra head <<<"${ip%%::*}"
        IFS=: read -ra tail <<<"${ip#*::}"
        while ((${#head[@]} + ${#tail[@]} < 8)); do head+=(0); done
    else
        IFS=: read -ra head <<<"${ip}"
    fi
    for group in "${head[@]}" "${tail[@]}"; do
        out+="$(printf '%04x' "$((16#${group}))"):"
    done
    printf '%s\n' "${out%:}"
}

# auto_address_rejected <ip>: if a valid IP literal is in a range that an auto-detected address is
# never in, prints what it is ("a private address (RFC 1918)") and succeeds; fails for a public one.
auto_address_rejected() {
    local ip="$1" entry subnet target
    if is_valid_ipv4 "${ip}"; then
        target="$(ipv4_to_int "${ip}")"
        for entry in "${AUTO_ADDRESS_REJECTED_IPV4[@]}"; do
            subnet="${entry%% *}"
            if ipv4_in_subnet "${target}" "${subnet%/*}" "${subnet#*/}"; then
                printf '%s\n' "${entry#* }"
                return 0
            fi
        done
        return 1
    fi
    case "$(ipv6_expand "${ip}")" in
        0000:0000:0000:0000:0000:0000:0000:0000) echo "an unspecified address" ;;
        0000:0000:0000:0000:0000:0000:0000:0001) echo "a loopback address" ;;
        f[cd]??:*) echo "a unique local address (fc00::/7)" ;;
        fe[89ab]?:*) echo "a link-local address" ;;
        ff??:*) echo "a multicast address" ;;
        2001:0db8:*) echo "a documentation address (RFC 3849)" ;;
        0000:0000:0000:0000:0000:ffff:*) echo "an IPv4-mapped address (::ffff:0:0/96)" ;;
        0064:ff9b:0000:0000:0000:0000:*) echo "a NAT64 address (64:ff9b::/96)" ;;
        *) return 1 ;;
    esac
}

# printable <text>: the first 60 characters of an answer, for the log, with control characters as '?'.
printable() {
    local text="${1:0:60}"
    printf '%s\n' "${text//[^[:print:]]/?}"
}

# parse_address_response <HTTP response>: prints the body of an "HTTP/1.x 200" response, without
# surrounding whitespace; fails, printing why, for any other status, a response without a body, or a
# body shorter or longer than its Content-Length (a cut connection: fetch_https accepts a server
# closing it without a TLS close_notify, as some of the sources do).
parse_address_response() {
    local response="${1//$'\r'/}" status headers body length_re=$'\n''content-length:[[:space:]]*([0-9]+)'
    status="${response%%$'\n'*}"
    if [[ ! "${status}" =~ ^HTTP/1\.[01]\ 200([[:space:]]|$) ]]; then
        printf '%s\n' "an HTTP status other than 200 ('$(printable "${status}")')"
        return 1
    fi
    if [[ "${response}" != *$'\n\n'* ]]; then
        echo "a response without a body"
        return 1
    fi
    headers="${response%%$'\n\n'*}"
    # The length is counted on the body as sent, with its line ends.
    if [[ "$1" == *$'\r\n\r\n'* ]]; then body="${1#*$'\r\n\r\n'}"; else body="${1#*$'\n\n'}"; fi
    if [[ "${headers,,}" =~ ${length_re} ]] && ((10#${BASH_REMATCH[1]} != ${#body})); then
        printf '%s\n' "a body of ${#body} bytes instead of its Content-Length ${BASH_REMATCH[1]}"
        return 1
    fi
    trim "${response#*$'\n\n'}"
    echo
}

# fetch_https <url>: prints the response to "GET <url>" (HTTP/1.0) over TLS, at most 4 KiB. openssl
# s_client aborts the handshake unless the certificate chains to a CA of ca-certificates and is valid
# for the host name; -quiet also keeps reading after the request until the server closes, and
# -ignore_unexpected_eof accepts a close without close_notify (parse_address_response checks the
# length). The request never takes longer than AUTO_ADDRESS_TIMEOUT seconds. Returns the exit code
# of openssl, or 124 (from timeout) when the time ran out.
fetch_https() {
    local rest="${1#https://}" host path
    host="${rest%%/*}"
    path="${rest#"${host}"}"
    path="/${path#/}"
    printf 'GET %s HTTP/1.0\r\nHost: %s\r\nUser-Agent: aspia-server\r\nAccept: text/plain\r\nConnection: close\r\n\r\n' \
            "${path}" "${host}" \
        | timeout -k 1 "${AUTO_ADDRESS_TIMEOUT}" openssl s_client -quiet -ignore_unexpected_eof \
            -connect "${host}:443" -servername "${host}" -verify_hostname "${host}" -verify_return_error \
            -CAfile "${AUTO_ADDRESS_CA_FILE}" 2>/dev/null \
        | head -c 4096
    return "${PIPESTATUS[1]}"
}

# detect_public_address: tries every source in AUTO_ADDRESS_SOURCES in turn and sets DETECTED_ADDRESS
# to the first answer that is a public IP address, logging which source it was. Logs why each other
# source was skipped. Runs in this shell, not in $(...), and waits for each request with "wait", which a
# trapped signal interrupts at once: a stop request (STOPPING, set by on_signal) ends the detection
# without waiting for the request or asking another source; it fails then.
detect_public_address() {
    local src response rc ip why fd
    DETECTED_ADDRESS=""
    log "Relay: ASPIA_RELAY_PUBLIC_ADDRESS=auto: detecting the public address (sources, in this order:" \
        "${AUTO_ADDRESS_SOURCES[*]})."
    for src in "${AUTO_ADDRESS_SOURCES[@]}"; do
        ((!STOPPING)) || return 1
        rc=0
        exec {fd}< <(fetch_https "${src}")
        wait "$!" || rc=$?
        if ((STOPPING)); then
            exec {fd}<&-
            return 1
        fi
        # The response is at most 4 KiB, so it fits into the pipe and fetch_https has already ended.
        # read keeps the line ends at its end, which parse_address_response counts.
        response=""
        IFS= read -r -d '' -u "${fd}" response || true
        exec {fd}<&-
        if ((rc == 124)); then
            warn "Relay: ${src} did not answer within ${AUTO_ADDRESS_TIMEOUT} s; trying the next source."
            continue
        elif ((rc != 0)); then
            warn "Relay: ${src}: no TLS connection, or its certificate could not be verified (openssl" \
                "exit code ${rc}); trying the next source."
            continue
        elif [[ -z "${response}" ]]; then
            warn "Relay: ${src} sent an empty answer; trying the next source."
            continue
        fi
        if ! ip="$(parse_address_response "${response}")"; then
            warn "Relay: ${src} answered with ${ip}; trying the next source."
            continue
        fi
        if ! is_valid_ip "${ip}"; then
            warn "Relay: ${src} answered '$(printable "${ip}")', which is not an IP address; trying the next source."
            continue
        fi
        if why="$(auto_address_rejected "${ip}")"; then
            warn "Relay: ${src} answered ${ip}, ${why}, not a public address; trying the next source."
            continue
        fi
        log "Relay: ASPIA_RELAY_PUBLIC_ADDRESS=auto: detected the public address ${ip} (source: ${src})."
        DETECTED_ADDRESS="${ip}"
        return 0
    done
    return 1
}

# ---------------------------------------------------------------------------------------------
# Roles (ASPIA_ROLE)

# resolve_role: sets SERVICES from ROLE; an unknown value is fatal.
resolve_role() {
    local services
    services="$(role_services "${ROLE}")" \
        || die "ASPIA_ROLE='${ROLE}' is not one of: all (the default: Router and Relay), router, relay. Nothing was changed."
    read -ra SERVICES <<<"${services}"
}

# has_service <name>: this role runs that process.
has_service() { [[ " ${SERVICES[*]} " == *" $1 "* ]]; }

# remote_router: the Relay of this container connects to a Router on another machine (ASPIA_ROLE=relay).
remote_router() { ! has_service router; }

# warn_ignored: names every variable that is set but has no effect in this role, so that a .env
# file shared between roles does not look like it applies. Once per start (not again after the
# PUID/PGID re-exec). Empty values count as unset, as everywhere else.
warn_ignored() {
    [[ -z "${_ASPIA_PRIVDROP_DONE:-}" ]] || return 0
    local name pattern why
    local -a ignored=()
    if has_service router && [[ -n "${ASPIA_ROUTER_LEGACY_PORT:-}" ]]; then
        warn "ASPIA_ROUTER_LEGACY_PORT is ignored: Aspia 3.1 has no port for 2.x hosts; ${LAST_2X_IMAGE} was the last version with it."
    fi
    case "${ROLE}" in
        router)
            pattern='^(EXTERNAL_IP|ASPIA_RELAY_.*)$'
            why="this container runs no Relay (ASPIA_ROLE=router)"
            ;;
        relay)
            pattern='^ASPIA_ROUTER_.*$'
            why="this container runs no Router (ASPIA_ROLE=relay); they belong to the Router's container"
            ;;
        *)
            pattern='^ASPIA_RELAY_ROUTER_.*$'
            why="the Relay in this container always uses the Router in this container (ASPIA_ROLE=all); they are for ASPIA_ROLE=relay"
            ;;
    esac
    while IFS= read -r name; do
        [[ "${name}" =~ ${pattern} && -n "${!name:-}" ]] && ignored+=("${name}")
    done < <(compgen -e)
    ((${#ignored[@]} == 0)) || warn "Ignored: ${ignored[*]}: ${why}."
}

# is_valid_router_address: what ASPIA_RELAY_ROUTER_ADDRESS accepts: an IP literal, or a DNS name:
# at most 253 characters in labels of 1 to 63 letters, digits, '_' or '-' (not at either end of a
# label), with one optional trailing dot. A value whose last label is all digits or 0x and hex digits
# and that is not an IPv4 address (192.168.1.300, 10.1, 010.0.0.1, 0x7f.0.0.1, 0x0a000001) is
# refused: the resolver would read it as an address in its own way (010.0.0.1 as octal, 10.1 as
# 10.0.0.1, 0x7f.0.0.1 as hex). The Relay resolves a name itself on every
# connection attempt; an unknown name is logged as SPECIFIED_HOST_NOT_FOUND and retried.
is_valid_router_address() {
    local label='[A-Za-z0-9_]([A-Za-z0-9_-]{0,61}[A-Za-z0-9_])?'
    is_valid_ip "$1" && return 0
    [[ "${1%.}" =~ (^|\.)([0-9]+|0[xX][0-9A-Fa-f]*)$ ]] && return 1
    is_valid_hostname "$1" 253 && [[ "$1" =~ ^${label}(\.${label})*\.?$ ]]
}

# resolve_router_key: sets ROUTER_KEY from ASPIA_RELAY_ROUTER_PUBLIC_KEY or from the file named by
# ASPIA_RELAY_ROUTER_PUBLIC_KEY_FILE (one of them, not both), and checks that it is 64 hex digits.
resolve_router_key() {
    local real value="${ASPIA_RELAY_ROUTER_PUBLIC_KEY:-}" file="${ASPIA_RELAY_ROUTER_PUBLIC_KEY_FILE:-}"
    if [[ -n "${value}" && -n "${file}" ]]; then
        die "Both ASPIA_RELAY_ROUTER_PUBLIC_KEY and ASPIA_RELAY_ROUTER_PUBLIC_KEY_FILE are set. Set one of them. Nothing was changed."
    fi
    if [[ -n "${file}" ]]; then
        [[ -f "${file}" && -r "${file}" ]] || die "ASPIA_RELAY_ROUTER_PUBLIC_KEY_FILE='${file}': no readable file at that" \
            "path in the container. Mount the Router's relay.pub there (read-only is enough). Nothing was changed."
        # PUID/PGID chown both volumes, which would hit a read-only mount or re-own the user's own file.
        real="$(realpath -m -- "${file}")"
        if [[ -n "${PUID:-}${PGID:-}" && ( "${real}" == "${CONFIG_DIR}"/* || "${real}" == "${DATA_DIR}"/* ) ]]; then
            die "ASPIA_RELAY_ROUTER_PUBLIC_KEY_FILE='${file}' is inside ${CONFIG_DIR} or ${DATA_DIR}, which PUID/PGID" \
                "re-own to that user. Mount the key file somewhere else (/run/aspia/router-relay.pub)" \
                "or use ASPIA_RELAY_ROUTER_PUBLIC_KEY. Nothing was changed."
        fi
        ROUTER_KEY="$(read_key "${file}")"
        [[ -n "${ROUTER_KEY}" ]] || die "ASPIA_RELAY_ROUTER_PUBLIC_KEY_FILE='${file}' does not hold a key (64 hex digits)." \
            "It must be a copy of the Router's /etc/aspia/relay.pub. Nothing was changed."
    else
        ROUTER_KEY="$(trim "${value}")"
        [[ "${ROUTER_KEY}" =~ ^[0-9A-Fa-f]{64}$ ]] || die "ASPIA_RELAY_ROUTER_PUBLIC_KEY='${value}' is not a key (64 hex digits)." \
            "Use the content of the Router's /etc/aspia/relay.pub (the Router prints it at startup as" \
            "'Public key for relays'). Nothing was changed."
    fi
}

# ---------------------------------------------------------------------------------------------
# Phase 0: run as PUID:PGID instead of root, if requested. A no-op when neither is set.
#
# Split in two so that ownership is never touched before every validate_* has passed ("nothing was
# changed" must stay true when a start is refused): validate_puid_pgid only checks the variables
# (called from the validate phase, like every other require_*); drop_privileges does the chown and
# the re-exec, called only once every validate_* has succeeded. validate_puid_pgid is skipped after
# the re-exec (_ASPIA_PRIVDROP_DONE): by then EUID is the target uid, not 0, so its own "must start
# as root" check would otherwise misfire on a value that was already valid.

validate_puid_pgid() {
    [[ -n "${_ASPIA_PRIVDROP_DONE:-}" ]] && return 0
    local puid="${PUID:-}" pgid="${PGID:-}"
    [[ -z "${puid}" && -z "${pgid}" ]] && return 0   # default: stay root, exactly like before PR 3

    [[ -n "${puid}" && -n "${pgid}" ]] \
        || die "PUID and PGID must both be set, or both left unset (got PUID='${puid}' PGID='${pgid}')."
    if ! [[ "${puid}" =~ ^[0-9]+$ ]] || ! ((10#${puid} <= 2147483647)); then
        die "PUID='${puid}' is not a valid user id."
    fi
    if ! [[ "${pgid}" =~ ^[0-9]+$ ]] || ! ((10#${pgid} <= 2147483647)); then
        die "PGID='${pgid}' is not a valid group id."
    fi
    ((EUID == 0)) \
        || die "PUID/PGID require the container to start as root; do not combine them with 'docker run --user'."
}

# drop_privileges <args...>: chowns the two volumes to PUID:PGID and re-execs this script as that
# user, passing on the resolved Relay address (so "auto" is not queried twice). Guarded by
# _ASPIA_PRIVDROP_DONE (not EUID, so that PUID=0/PGID=0 does not loop forever). Only called from
# main() after every validate_* has already passed.
drop_privileges() {
    [[ -n "${_ASPIA_PRIVDROP_DONE:-}" ]] && return 0
    local puid="${PUID:-}" pgid="${PGID:-}"
    [[ -z "${puid}" && -z "${pgid}" ]] && return 0

    # -h: a symbolic link in the volumes is re-owned itself, never the file it points to.
    chown -Rh "${puid}:${pgid}" -- "${CONFIG_DIR}" "${DATA_DIR}"
    if [[ "${ROLE}" == all ]]; then
        log "PUID/PGID set: running the Router and the Relay as uid=${puid} gid=${pgid}."
    else
        log "PUID/PGID set: running ${SERVICES[*]} as uid=${puid} gid=${pgid}."
    fi
    export _ASPIA_PRIVDROP_DONE=1
    if has_service relay; then
        # Both names, already resolved: "auto" is not queried twice, and validate_relay does not log a
        # spurious "set to different values" the second time around when only one of them was given.
        export ASPIA_RELAY_PUBLIC_ADDRESS="${PEER_PUBLIC_ADDRESS}"
        export EXTERNAL_IP="${PEER_PUBLIC_ADDRESS}"
    fi
    if remote_router; then
        # The key as read by root: the file may not be readable by PUID.
        export ASPIA_RELAY_ROUTER_PUBLIC_KEY="${ROUTER_KEY}"
        unset ASPIA_RELAY_ROUTER_PUBLIC_KEY_FILE
    fi
    # No capability survives the switch to a non-root uid; the bounding set and the inheritable set
    # are cleared too (the bounding set only with CAP_SETPCAP, see child_privileges).
    local -a bounding=()
    has_cap "${CAP_SETPCAP}" && bounding=(--bounding-set=-all)
    exec setpriv --reuid="${puid}" --regid="${pgid}" --clear-groups --inh-caps=-all "${bounding[@]}" \
        --no-new-privs -- "$0" "$@"
}

# ---------------------------------------------------------------------------------------------
# Phase 1: validate. Runs before anything is written to the volumes.

# refuse_2x_data: Aspia 3.1 cannot read 2.x data; the LAST_2X_IMAGE converts it. router.json is 2.x
# data that was never converted (3.0.x renames it once it has); so is a relay.json that no
# non-empty relay.conf covers (3.0.x converts relay.json only when relay.conf is missing or empty),
# even without any Router file. router.pub alone is not: 3.0.x keeps it. Called once per start,
# whatever the role, before any role-specific check and while nothing has been written yet.
refuse_2x_data() {
    local file
    if [[ -f "${ROUTER_JSON}" ]]; then
        file="${ROUTER_JSON}"
    elif [[ -f "${RELAY_JSON}" && ! -s "${RELAY_CONF}" ]]; then
        file="${RELAY_JSON}"
    else
        return 0
    fi
    die "Found Aspia 2.x data (${file}). Aspia 3.1 cannot read it. Upgrade in two steps: start the image" \
        "${LAST_2X_IMAGE} once on these volumes and wait until it is healthy (it converts" \
        "the data), stop it, then start this image. Nothing was changed."
}

validate_router() {
    local file found=()

    require_port ASPIA_ROUTER_CLIENT_PORT
    require_port ASPIA_ROUTER_HOST_PORT
    require_port ASPIA_ROUTER_STUN_PORT
    require_bool ASPIA_ROUTER_STUN_ENABLED
    require_allowed_ips ASPIA_ROUTER_CLIENT_ALLOWED_IPS
    require_allowed_ips ASPIA_ROUTER_HOST_ALLOWED_IPS
    require_allowed_ips ASPIA_ROUTER_RELAY_ALLOWED_IPS
    # This image's own Relay always reaches the Router over 127.0.0.1 (notes section 4, router/address
    # in relay.conf). Excluding it from relay/white_list would silently lock out the co-located Relay:
    # it looks like it starts (the port opens), but every connection is closed immediately and the
    # container never becomes healthy. Catch it here instead of a several-minute unexplained timeout.
    # Only when that Relay exists (ASPIA_ROLE=all): with ASPIA_ROLE=router every Relay is remote.
    if has_service relay && [[ -n "${ASPIA_ROUTER_RELAY_ALLOWED_IPS:-}" ]] \
        && ! allowed_ips_covers_ipv4 "${ASPIA_ROUTER_RELAY_ALLOWED_IPS}" 127.0.0.1; then
        die "ASPIA_ROUTER_RELAY_ALLOWED_IPS='${ASPIA_ROUTER_RELAY_ALLOWED_IPS}' does not cover 127.0.0.1." \
            "In this image the Router and its own co-located Relay always connect over the loopback" \
            "address; excluding it would lock the Relay in this container out. Add 127.0.0.1 to the" \
            "list, e.g. '127.0.0.1,${ASPIA_ROUTER_RELAY_ALLOWED_IPS}'. Nothing was changed."
    fi
    refuse_path_override ASPIA_ROUTER_CONFIG_FILE "${ROUTER_CONF}"
    refuse_path_override ASPIA_ROUTER_DB_FILE "${ROUTER_DB}"

    if [[ -s "${ROUTER_CONF}" ]]; then
        [[ -f "${ROUTER_DB}" ]] || die "Found ${ROUTER_CONF}, but not the database ${ROUTER_DB}." \
            "Mount the database volume at ${DATA_DIR} (./data/database in docker-compose.yml). Nothing was changed."
        ROUTER_STATE=existing
    else
        # A Relay configuration left over (for example with the wrong volume mounted) counts too:
        # a new Router would get new keys, and that Relay's Router key would no longer match.
        for file in "${ROUTER_CONF}" "${HOST_PUB}" "${RELAY_PUB}" "${ROUTER_PUB}" "${ROUTER_DB}" \
            "${RELAY_CONF}"; do
            [[ -e "${file}" ]] && found+=("${file}")
        done
        if ((${#found[@]})); then
            die "No Router configuration (${ROUTER_CONF}), but these files exist: ${found[*]}." \
                "Creating a new configuration would create new keys, and every host would have to be reconfigured." \
                "Check that both volumes are mounted: configuration at ${CONFIG_DIR}, database at ${DATA_DIR}." \
                "To really start from scratch, move these files away yourself. Nothing was changed."
        fi
        ROUTER_STATE=new
    fi
}

# validate_remote_relay: ASPIA_ROLE=relay only. Every missing required setting is named in one
# message; then the values and the volume are checked.
validate_remote_relay() {
    local file list
    local -a missing=() found=()
    [[ -n "$(trim "${ASPIA_RELAY_ROUTER_ADDRESS:-}")" ]] \
        || missing+=("ASPIA_RELAY_ROUTER_ADDRESS (the address of the Router)")
    [[ -n "$(trim "${ASPIA_RELAY_ROUTER_PUBLIC_KEY:-}")" || -n "${ASPIA_RELAY_ROUTER_PUBLIC_KEY_FILE:-}" ]] \
        || missing+=("ASPIA_RELAY_ROUTER_PUBLIC_KEY or ASPIA_RELAY_ROUTER_PUBLIC_KEY_FILE (the Router's relay.pub)")
    [[ -n "$(trim "${ASPIA_RELAY_PUBLIC_ADDRESS:-${EXTERNAL_IP:-}}")" ]] \
        || missing+=("ASPIA_RELAY_PUBLIC_ADDRESS or its alias EXTERNAL_IP (the address clients and hosts use to reach this Relay)")
    if ((${#missing[@]})); then
        list="$(printf '; %s' "${missing[@]}")"
        die "ASPIA_ROLE=relay needs these settings, which are not set: ${list#; }." \
            "See \"Running a Relay on a separate host\" in README.md. Nothing was changed."
    fi

    is_valid_router_address "${ASPIA_RELAY_ROUTER_ADDRESS}" \
        || die "ASPIA_RELAY_ROUTER_ADDRESS='${ASPIA_RELAY_ROUTER_ADDRESS}' is not an IP address or a host name. Nothing was changed."
    require_port ASPIA_RELAY_ROUTER_PORT
    resolve_router_key

    # A Router's (or a 2.x) configuration volume mounted here by mistake: this start would rewrite
    # that installation's relay.conf. A Relay on its own needs a volume of its own. relay.pub alone
    # is allowed: it may be the key file mounted there for ASPIA_RELAY_ROUTER_PUBLIC_KEY_FILE
    # (not with PUID/PGID: resolve_router_key refuses a key file inside the volumes then; the
    # documented place for the file is /run/aspia/...).
    for file in "${ROUTER_CONF}" "${RELAY_JSON}" "${ROUTER_PUB}" "${HOST_PUB}" "${ROUTER_DB}"; do
        [[ -e "${file}" ]] && found+=("${file}")
    done
    if ((${#found[@]})); then
        die "ASPIA_ROLE=relay, but the volumes hold a Router's or an Aspia 2.x installation: ${found[*]}." \
            "A Relay on its own needs its own, empty configuration volume at ${CONFIG_DIR}. To run the" \
            "Router from these files, use ASPIA_ROLE=router or all. Nothing was changed."
    fi
}

validate_relay() {
    local addr

    require_port ASPIA_RELAY_PEER_PORT
    require_minutes ASPIA_RELAY_IDLE_TIMEOUT
    require_count ASPIA_RELAY_MAX_PEERS
    refuse_path_override ASPIA_RELAY_CONFIG_FILE "${RELAY_CONF}"
    if remote_router; then validate_remote_relay; fi

    if [[ -n "${ASPIA_RELAY_PUBLIC_ADDRESS:-}" && -n "${EXTERNAL_IP:-}" \
        && "${ASPIA_RELAY_PUBLIC_ADDRESS}" != "${EXTERNAL_IP}" ]]; then
        log "Relay: both ASPIA_RELAY_PUBLIC_ADDRESS='${ASPIA_RELAY_PUBLIC_ADDRESS}' and EXTERNAL_IP='${EXTERNAL_IP}'" \
            "are set to different values; using ASPIA_RELAY_PUBLIC_ADDRESS (EXTERNAL_IP is its alias)."
    fi
    addr="${ASPIA_RELAY_PUBLIC_ADDRESS:-${EXTERNAL_IP:-}}"

    if [[ -z "${addr}" || "${addr}" =~ ^[[:space:]]*$ ]]; then
        die "ASPIA_RELAY_PUBLIC_ADDRESS is not set, and its alias EXTERNAL_IP is not set either." \
            "Set one of them to the public address of this server, the one clients and hosts use to" \
            "reach the Relay: an IP address, a host name, or 'auto' to detect it, e.g." \
            "'docker run -e ASPIA_RELAY_PUBLIC_ADDRESS=203.0.113.10 ...' or that variable in the .env" \
            "file next to docker-compose.yml. Nothing was changed."
    fi

    if [[ "${addr}" == "auto" ]]; then
        if ! detect_public_address; then
            # docker stop during the detection: nothing has been changed yet, so just end.
            ((!STOPPING)) || exit 0
            die "ASPIA_RELAY_PUBLIC_ADDRESS=auto: could not detect the public IP address of this server" \
                "(tried: ${AUTO_ADDRESS_SOURCES[*]}, ${AUTO_ADDRESS_TIMEOUT} s each; the reasons are above)." \
                "Set EXTERNAL_IP (or ASPIA_RELAY_PUBLIC_ADDRESS) to the public address explicitly, e.g." \
                "EXTERNAL_IP=203.0.113.10, or check that the container can reach these sites over HTTPS." \
                "Nothing was changed."
        fi
        addr="${DETECTED_ADDRESS}"
    elif ! is_valid_address "${addr}"; then
        die "ASPIA_RELAY_PUBLIC_ADDRESS='${addr}' is not an IP address or a host name (at most 64" \
            "characters: letters, digits, '.', '_' or '-'). Nothing was changed."
    fi
    PEER_PUBLIC_ADDRESS="${addr}"

    if [[ -s "${RELAY_CONF}" ]]; then
        RELAY_STATE=existing
    else
        RELAY_STATE=new
    fi
}

# ---------------------------------------------------------------------------------------------
# Phase 2: prepare the configuration.

# apply_router_settings: writes every ASPIA_ROUTER_* variable that is set into router.conf, which
# must already exist.
apply_router_settings() {
    [[ -n "${ASPIA_ROUTER_CLIENT_PORT:-}" ]] \
        && set_conf_value "${ROUTER_CONF}" client port "${ASPIA_ROUTER_CLIENT_PORT}" Router
    [[ -n "${ASPIA_ROUTER_HOST_PORT:-}" ]] \
        && set_conf_value "${ROUTER_CONF}" host port "${ASPIA_ROUTER_HOST_PORT}" Router
    if [[ -n "${ASPIA_ROUTER_STUN_ENABLED:-}" ]]; then
        local enabled="${ASPIA_ROUTER_STUN_ENABLED,,}"
        [[ "${enabled}" == "true" ]] && enabled=1
        [[ "${enabled}" == "false" ]] && enabled=0
        set_conf_value "${ROUTER_CONF}" stun enabled "${enabled}" Router
    fi
    [[ -n "${ASPIA_ROUTER_STUN_PORT:-}" ]] \
        && set_conf_value "${ROUTER_CONF}" stun port "${ASPIA_ROUTER_STUN_PORT}" Router
    [[ -n "${ASPIA_ROUTER_CLIENT_ALLOWED_IPS:-}" ]] \
        && set_conf_value "${ROUTER_CONF}" client white_list "${ASPIA_ROUTER_CLIENT_ALLOWED_IPS}" Router
    [[ -n "${ASPIA_ROUTER_HOST_ALLOWED_IPS:-}" ]] \
        && set_conf_value "${ROUTER_CONF}" host white_list "${ASPIA_ROUTER_HOST_ALLOWED_IPS}" Router
    [[ -n "${ASPIA_ROUTER_RELAY_ALLOWED_IPS:-}" ]] \
        && set_conf_value "${ROUTER_CONF}" relay white_list "${ASPIA_ROUTER_RELAY_ALLOWED_IPS}" Router
    return 0
}

# save_admin_password <--create-config output>: the Router creates 'admin' with a random password and
# prints it once. Saves the "Password:" line to ADMIN_PASSWORD_FILE (atomically: a temporary file in the
# same directory, mode 0600 from the umask, then mv; owned by whoever runs this script: root, or
# PUID/PGID). If the line is not found, the whole output is saved instead, so the password is never
# lost. Never prints the password.
save_admin_password() {
    local password tmp
    # Not replace_file/copy_file: they chown --reference an existing file, and there is none here.
    password="$(printf '%s\n' "$1" | sed -n 's/\r$//; s/^[[:space:]]*Password:[[:space:]]*//p' | head -n 1)"
    tmp="$(mktemp "${ADMIN_PASSWORD_FILE}.XXXXXX")"
    if [[ -n "${password}" ]]; then
        printf 'User name: admin\nPassword: %s\n' "${password}" > "${tmp}"
    else
        printf '%s\n' "$1" > "${tmp}"
        warn "Router: no 'Password:' line in the output of aspia_router --create-config. The whole output is" \
            "in ${ADMIN_PASSWORD_FILE}; look there for the password of 'admin'."
    fi
    chmod 0600 -- "${tmp}"
    mv -f -- "${tmp}" "${ADMIN_PASSWORD_FILE}"
}

prepare_router() {
    local output file
    case "${ROUTER_STATE}" in
        new)
            log "Router: no configuration found, creating a new one."
            # The output contains the random password; it is not copied to the log.
            if ! output="$(/usr/bin/aspia_router --create-config 2>&1)"; then
                printf '%s\n' "${output}" | grep -vi 'password' >&2 || true
                die "aspia_router --create-config failed."
            fi
            for file in "${ROUTER_CONF}" "${HOST_PUB}" "${RELAY_PUB}" "${ROUTER_DB}"; do
                [[ -s "${file}" ]] || die "aspia_router --create-config did not create ${file}."
            done
            save_admin_password "${output}"
            log "Router: created ${ROUTER_CONF}, ${HOST_PUB}, ${RELAY_PUB} and ${ROUTER_DB}."
            log "Router: created the administrator account 'admin' with a random password, saved in" \
                "${ADMIN_PASSWORD_FILE} (mode 0600). Read it with e.g." \
                "'docker exec <container> cat ${ADMIN_PASSWORD_FILE}'. Log in, change it, then delete the file."
            # Until that first login, whoever reaches the client port first and knows the password owns the
            # Router. Who can reach it also depends on ASPIA_ROUTER_CLIENT_BIND_IP, which this container cannot see.
            if [[ -z "${ASPIA_ROUTER_CLIENT_ALLOWED_IPS:-}" ]]; then
                warn "Router: first start without a client allow-list (ASPIA_ROUTER_CLIENT_ALLOWED_IPS), and" \
                    "'admin' has no two-factor authentication yet. The password is random, but the first login" \
                    "still matters: log in now, change the password and delete ${ADMIN_PASSWORD_FILE}." \
                    "On a new install, before the first start, set ASPIA_ROUTER_CLIENT_ALLOWED_IPS to your own" \
                    "address, or publish the client port on 127.0.0.1 only (ASPIA_ROUTER_CLIENT_BIND_IP) and use" \
                    "an SSH tunnel (README.md, \"Quick start\")."
            fi
            ;;
        existing)
            log "Router: using the existing configuration ${ROUTER_CONF}."
            if [[ -e "${ADMIN_PASSWORD_FILE}" ]]; then
                log "Router: ${ADMIN_PASSWORD_FILE} still exists. Once you have changed the password of 'admin'," \
                    "delete it."
            fi
            ;;
    esac
    apply_router_settings
}

# apply_relay_settings: writes public_address and every ASPIA_RELAY_* variable
# that is set into relay.conf, which must already exist. router/public_key keeps its own
# fill-only-when-empty rule (unrelated to the new variables: it is derived from the Router, never
# given directly by the user).
apply_relay_settings() {
    local current

    set_conf_value "${RELAY_CONF}" peer public_address "${PEER_PUBLIC_ADDRESS}" Relay
    [[ -n "${ASPIA_RELAY_PEER_PORT:-}" ]] \
        && set_conf_value "${RELAY_CONF}" peer port "${ASPIA_RELAY_PEER_PORT}" Relay
    [[ -n "${ASPIA_RELAY_IDLE_TIMEOUT:-}" ]] \
        && set_conf_value "${RELAY_CONF}" peer idle_timeout "${ASPIA_RELAY_IDLE_TIMEOUT}" Relay
    [[ -n "${ASPIA_RELAY_MAX_PEERS:-}" ]] \
        && set_conf_value "${RELAY_CONF}" peer max_count "${ASPIA_RELAY_MAX_PEERS}" Relay

    if remote_router; then
        # The Router is on another machine: its address and key are required variables, written on
        # every start like every other variable that is set. The port is optional (unset leaves
        # the file alone; --create-config writes the Router's default, 8063).
        set_conf_value "${RELAY_CONF}" router address "${ASPIA_RELAY_ROUTER_ADDRESS}" Relay
        [[ -n "${ASPIA_RELAY_ROUTER_PORT:-}" ]] \
            && set_conf_value "${RELAY_CONF}" router port "${ASPIA_RELAY_ROUTER_PORT}" Relay
        set_conf_value "${RELAY_CONF}" router public_key "${ROUTER_KEY}" Relay
        return 0
    fi

    # router/public_key is filled only when it is empty; a key set by hand is left alone.
    current="$(ini_get "${RELAY_CONF}" router public_key "")"
    if [[ -z "${current}" ]]; then
        [[ -n "${ROUTER_KEY}" ]] || die "${RELAY_CONF} has no [router] public_key, and ${RELAY_PUB} does not exist."
        backup "${RELAY_CONF}"
        ini_set "${RELAY_CONF}" router public_key "${ROUTER_KEY}"
        log "Relay: set [router] public_key from the Router key."
    elif [[ -n "${ROUTER_KEY}" && "${current,,}" != "${ROUTER_KEY,,}" ]]; then
        warn "[router] public_key in ${RELAY_CONF} differs from the Router key. Left as it is;" \
            "the Relay will not connect to this container's Router unless that is intended."
    fi
    return 0
}

prepare_relay() {
    local output
    # A remote Router's key was resolved in validate_remote_relay (which refuses a Router volume); this
    # container's own Router has written relay.pub by now (prepare_router runs first).
    remote_router || ROUTER_KEY="$(read_key "${RELAY_PUB}")"

    case "${RELAY_STATE}" in
        new)
            log "Relay: no configuration found, creating a new one."
            if ! output="$(/usr/bin/aspia_relay --create-config 2>&1)"; then
                printf '%s\n' "${output}" >&2
                die "aspia_relay --create-config failed."
            fi
            [[ -s "${RELAY_CONF}" ]] || die "aspia_relay --create-config did not create ${RELAY_CONF}."
            BACKED_UP[${RELAY_CONF}]=1   # created in this start: nothing of the user's to copy
            ;;
        existing)
            log "Relay: using the existing configuration ${RELAY_CONF}."
            ;;
    esac

    apply_relay_settings
}

# restrict_permissions: the volumes hold the private keys (router.conf, relay.conf, the backups of
# both, the files of a 3.0.x migration), the user database, initial-admin-password and
# relay.pub, the key a Relay registers with. Older starts left most of them 0644 in 0755 directories:
# readable by every user of the server when the volumes are bind mounts. Now the directories are
# 0700 and the files 0600. host.pub stays 0644: it is the public key every Host is given, and the
# log prints it on every start. Only what this uid owns is changed (without CAP_FOWNER root cannot
# chmod the files of another uid; a start with PUID/PGID restricts them); symbolic links are skipped.
restrict_permissions() {
    local path mode want list
    local -a changed=()
    for path in "${CONFIG_DIR}" "${DATA_DIR}" "${CONFIG_DIR}"/* "${DATA_DIR}"/*; do
        [[ ! -L "${path}" && -O "${path}" ]] || continue   # -O: also exists
        if [[ -d "${path}" ]]; then
            want=700
        elif [[ "${path}" == "${HOST_PUB}" ]]; then
            want=644
        elif [[ "${path}" == "${RELAY_PUB}" ]] && remote_router; then
            continue   # ASPIA_ROLE=relay: the user's copy of the Router's key, maybe a read-only mount
        else
            want=600
        fi
        mode="$(stat -c %a -- "${path}")"
        [[ "${mode: -3}" == "${want}" ]] && continue   # only the permission bits: a setgid directory stays so
        if chmod "${want}" -- "${path}" 2>/dev/null; then
            changed+=("${path} (${mode} -> ${want})")
        else
            warn "Cannot change the mode of ${path} (${mode}) to ${want}; left as it is."
        fi
    done
    ((${#changed[@]})) || return 0
    list="$(printf ', %s' "${changed[@]}")"
    log "Permissions: set the mode of ${list#, }."
}

# ---------------------------------------------------------------------------------------------
# Phase 3: start and supervise.

# child_privileges: sets CHILD_SETPRIV. The Aspia processes need no capability: every port is above
# 1024, and their files are their own. So they start without any, and with no_new_privs (which the
# Podman units do not set for the container). With PUID/PGID they are not root and have none anyway.
# As root, setpriv clears the bounding set, which takes CAP_SETPCAP (in cap_add of the shipped compose
# files and units); without it they keep the container's capabilities, as before. Root on files of
# another uid (an earlier start with PUID/PGID, a user's directory) keeps DAC_OVERRIDE to read them.
child_privileges() {
    CHILD_SETPRIV=(--inh-caps=-all --no-new-privs)
    ((EUID == 0)) || return 0
    if has_cap "${CAP_SETPCAP}"; then
        local bset=-all
        if [[ -n "$(find "${CONFIG_DIR}" "${DATA_DIR}" ! -user 0 -print -quit)" ]] && has_cap "${CAP_DAC_OVERRIDE}"; then
            bset+=,+dac_override
            log "${CONFIG_DIR} or ${DATA_DIR} holds files of another user: the Aspia processes keep" \
                "CAP_DAC_OVERRIDE to read them. Set PUID/PGID to that user, or chown the files to root."
        fi
        CHILD_SETPRIV+=("--bounding-set=${bset}")
    elif ((16#$(cap_eff))); then
        warn "No CAP_SETPCAP: the Aspia processes run as root with the capabilities of the container." \
            "Add SETPCAP to cap_add (README.md, \"Security settings\"), or set PUID/PGID."
    fi
}

# start_process <name> <command...>: starts the command in the background, with the privileges of
# child_privileges; its pid is in STARTED_PID (setpriv execs the command in the same process).
start_process() {
    local name="$1"
    shift
    setpriv "${CHILD_SETPRIV[@]}" -- "$@" &
    STARTED_PID=$!
    CHILDREN[${STARTED_PID}]="${name}"
    log "Started ${name} (pid ${STARTED_PID})."
}

# wait_listening <name> <pid> <port>: waits until <port> is listening, <pid> exits, or a stop is requested.
wait_listening() {
    local name="$1" pid="$2" port="$3" i
    for ((i = 0; i < LISTEN_TIMEOUT_SECONDS * 5; i++)); do
        ((STOPPING)) && return 0
        kill -0 "${pid}" 2>/dev/null || return 0   # the supervisor reports the exit
        if socket_state tcp "${TCP_LISTEN}" local "${port}"; then
            log "${name} is listening on ${port}/tcp."
            return 0
        fi
        sleep 0.2
    done
    warn "${name} is not listening on ${port}/tcp after ${LISTEN_TIMEOUT_SECONDS} s; see its log above."
}

start_router() {
    start_process aspia_router /usr/bin/aspia_router
    # The Relay connects to this port; starting it earlier costs a 15 s reconnect delay.
    wait_listening aspia_router "${STARTED_PID}" "$(ini_get "${ROUTER_CONF}" relay port 8063)"
}

start_relay() {
    start_process aspia_relay /usr/bin/aspia_relay
    wait_listening aspia_relay "${STARTED_PID}" "$(ini_get "${RELAY_CONF}" peer port 8070)"
}

# on_signal <signal>: forwards the signal to every running child; the supervisor collects them.
on_signal() {
    local pid
    if ((!STOPPING)); then
        log "Received SIG$1, stopping ${CHILDREN[*]:-}."
    fi
    STOPPING=1
    for pid in "${!CHILDREN[@]}"; do
        kill -s "$1" "${pid}" 2>/dev/null || true
    done
}

# child_exited <pid> <exit code>
child_exited() {
    local name="${CHILDREN[$1]}" pid
    unset "CHILDREN[$1]"
    if ((STOPPING)); then
        log "${name} stopped (exit code $2)."
        if ((EXIT_CODE == 0)); then EXIT_CODE="$2"; fi
        return 0
    fi
    # Nobody asked it to stop: stop the rest and exit non-zero so the restart policy applies.
    EXIT_CODE="$2"
    if ((EXIT_CODE == 0)); then EXIT_CODE=1; fi
    log "${name} exited unexpectedly (exit code $2). Stopping the other processes."
    STOPPING=1
    for pid in "${!CHILDREN[@]}"; do
        kill -s TERM "${pid}" 2>/dev/null || true
    done
}

supervise() {
    local pid rc
    while ((${#CHILDREN[@]})); do
        pid=""
        rc=0
        wait -n -p pid "${!CHILDREN[@]}" || rc=$?
        if [[ -n "${pid:-}" ]]; then   # wait -n -p unsets pid when a signal interrupts it
            child_exited "${pid}" "${rc}"
            continue
        fi
        # No pid: wait was interrupted by a trapped signal. The next wait -n returns any child
        # that exited in the meantime.
    done
    log "All processes have exited; exit code ${EXIT_CODE}."
    exit "${EXIT_CODE}"
}

# key_or_reason <file>: the key in <file>, or why there is none.
key_or_reason() {
    local key
    key="$(read_key "$1")"
    if [[ -z "${key}" ]]; then
        [[ -e "$1" ]] && key="not found ($1 holds no valid key)" || key="not found ($1 does not exist)"
    fi
    printf '%s\n' "${key}"
}

# The parts every startup summary has in common.
log_rule() { log "----------------------------------------------------------------------"; }
log_running_as() {
    if [[ -n "${PUID:-}" || -n "${PGID:-}" ]]; then
        log "Running as:                 uid=${PUID:-0} gid=${PGID:-0}"
    fi
}
log_ports_header() { log "Ports (publish them unchanged, host port = container port):"; }

# log_router_ports: the summary lines for the Router ports that clients and hosts use.
log_router_ports() {
    log "  $(ini_get "${ROUTER_CONF}" host port 8061)/tcp  Router: hosts"
    log "  $(ini_get "${ROUTER_CONF}" client port 8062)/tcp  Router: clients"
    if stun_enabled "${ROUTER_CONF}"; then
        log "  $(ini_get "${ROUTER_CONF}" stun port 8065)/udp  Router: STUN"
    fi
}

print_summary_all() {
    local key
    key="$(key_or_reason "${HOST_PUB}")"
    log_rule
    log "External address (Relay):  ${PEER_PUBLIC_ADDRESS}"
    log "Public key for hosts:      ${key}"
    log_running_as
    log_ports_header
    log_router_ports
    log "  $(ini_get "${RELAY_CONF}" peer port 8070)/tcp  Relay: clients and hosts"
    log "  $(ini_get "${ROUTER_CONF}" relay port 8063)/tcp  Router: relays (used inside the container)"
    log_rule
}

# ASPIA_ROLE=router: everything a Relay on another machine needs, and who may register as one.
print_summary_router() {
    local relay_port allowed relay_key
    relay_port="$(ini_get "${ROUTER_CONF}" relay port 8063)"
    allowed="$(ini_get "${ROUTER_CONF}" relay white_list "")"
    log_rule
    log "Role:                      router (ASPIA_ROLE): this container runs no Relay"
    log "Public key for hosts:      $(key_or_reason "${HOST_PUB}")"
    log "Public key for relays:     $(key_or_reason "${RELAY_PUB}")"
    log "  (set it as ASPIA_RELAY_ROUTER_PUBLIC_KEY on every Relay, with ASPIA_RELAY_ROUTER_PORT=${relay_port})"
    log_running_as
    log_ports_header
    log_router_ports
    log "  ${relay_port}/tcp  Router: relays (must be reachable from every Relay host)"
    if [[ -n "${allowed}" ]]; then
        log "Relays accepted from:      ${allowed} (ASPIA_ROUTER_RELAY_ALLOWED_IPS, [relay] white_list)"
    else
        warn "Relays are accepted from ANY address: [relay] white_list in ${ROUTER_CONF} is empty. Whoever" \
            "reaches ${relay_port}/tcp and has the key above can register as a Relay (at most five at a time)." \
            "Set ASPIA_ROUTER_RELAY_ALLOWED_IPS to the addresses of your Relays, or allow ${relay_port}/tcp" \
            "only from them in the firewall."
        # Only on installs that Aspia 3.0.x converted from 2.x: there relay.pub is a copy of host.pub, so
        # every Host knows that key.
        relay_key="$(read_key "${RELAY_PUB}")"
        if [[ -n "${relay_key}" && "${relay_key}" == "$(read_key "${HOST_PUB}")" ]]; then
            warn "The key for relays is the same as the key for hosts (an install migrated from Aspia 2.x)," \
                "so everyone who has configured a Host knows it."
        fi
    fi
    log_rule
}

# ASPIA_ROLE=relay: where it connects, and how to read a failure in the log.
print_summary_relay() {
    log_rule
    log "Role:                      relay (ASPIA_ROLE): the Router is on another machine"
    log "External address (Relay):  ${PEER_PUBLIC_ADDRESS}"
    log "Router:                    $(ini_get "${RELAY_CONF}" router address "")," \
        "port $(ini_get "${RELAY_CONF}" router port 8063)/tcp"
    log "Router public key:         $(ini_get "${RELAY_CONF}" router public_key "")"
    log_running_as
    log_ports_header
    log "  $(ini_get "${RELAY_CONF}" peer port 8070)/tcp  Relay: clients and hosts"
    log "The Relay logs 'Connection to the router is established' once the Router accepts it. If it does"
    log "not, its log says why, and it retries every 15 s: ACCESS_DENIED = wrong Router key;"
    log "SPECIFIED_HOST_NOT_FOUND, CONNECTION_REFUSED or SOCKET_TIMEOUT = the Router is not reachable at"
    log "that address and port; REMOTE_HOST_CLOSED right after connecting = the Router refused this Relay"
    log "(its ASPIA_ROUTER_RELAY_ALLOWED_IPS, or five Relays already connected)."
    log_rule
}

main() {
    local service router_version relay_version

    # Installed first: a stop request never interrupts a step that writes to the volumes
    # (bash runs the trap after the current command); later steps are then skipped.
    trap 'on_signal TERM' TERM
    trap 'on_signal INT' INT

    resolve_role
    mkdir -p "${CONFIG_DIR}" "${DATA_DIR}"
    warn_ignored

    # Every validate_* below only reads. Ownership is changed (drop_privileges) only once all of
    # them have passed, so a refused start never touches the volumes, PUID/PGID included.
    validate_puid_pgid
    refuse_2x_data
    for service in "${SERVICES[@]}"; do "validate_${service}"; done
    drop_privileges "$@"

    router_version="$(/usr/bin/aspia_router --version 2>/dev/null)" || router_version="aspia_router: unknown version"
    relay_version="$(/usr/bin/aspia_relay --version 2>/dev/null)" || relay_version="aspia_relay: unknown version"
    log "Aspia Server image ${ASPIA_VERSION:-unknown}: ${router_version}, ${relay_version}."
    [[ "${ROLE}" == all ]] || log "ASPIA_ROLE=${ROLE}: starting only ${SERVICES[*]}."

    for service in "${SERVICES[@]}"; do
        ((STOPPING)) || "prepare_${service}"
    done
    ((STOPPING)) || restrict_permissions
    ((STOPPING)) || child_privileges
    for service in "${SERVICES[@]}"; do
        ((STOPPING)) || "start_${service}"
    done
    ((STOPPING)) || "print_summary_${ROLE}"
    supervise
}

# tests/auto_address.sh sources this file to test the functions above; main runs only when executed.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
