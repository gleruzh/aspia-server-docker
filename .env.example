# Copy this file to .env next to docker-compose.yml, then uncomment and set what you need.
#
# Precedence for every ASPIA_ROUTER_*/ASPIA_RELAY_* variable below: if it is set, its value is
# written to router.conf/relay.conf on every start; if it is unset (or removed later), the value
# already in the file is left alone, so a hand edit of the config files survives. An empty value
# ("VAR=") counts as unset for this rule, except where a section says otherwise (the allow-lists).
# See README.md for the full variable table and details.
#
# Ports: both sides of every "ports:" mapping in docker-compose.yml come from the same variable,
# so a value set here also changes the published host port. Keep host port = container port: the
# Relay announces its own peer port to clients and hosts.

# ---------------------------------------------------------------------------------------------
# Relay: the public address it announces to clients and hosts (required)

# Required (or set ASPIA_RELAY_PUBLIC_ADDRESS below): an IP address, a host name, or 'auto' to
# detect the public IP of this server at every start (tries api.ipify.org, ifconfig.me and
# icanhazip.com in turn; the container refuses to start if none of them answer).
EXTERNAL_IP=203.0.113.10

# The new name for the variable above (an exact alias: same effect, no deprecation warning). Set
# either this or EXTERNAL_IP, not usually both. If both are set to different values, this one wins.
#ASPIA_RELAY_PUBLIC_ADDRESS=203.0.113.10

# The Relay's own TCP port. It tells clients and hosts this port, so changing it also changes the
# published host port in docker-compose.yml (host port = container port, from the same variable).
#ASPIA_RELAY_PEER_PORT=8070

# Minutes an idle peer connection is kept open.
#ASPIA_RELAY_IDLE_TIMEOUT=5

# Maximum number of peers (clients and hosts) the Relay serves at once.
#ASPIA_RELAY_MAX_PEERS=100

# ---------------------------------------------------------------------------------------------
# Router: ports

# Router port for Aspia 3.x hosts.
#ASPIA_ROUTER_HOST_PORT=8061

# Router port for Aspia 2.x hosts (kept for hosts not yet updated).
#ASPIA_ROUTER_LEGACY_PORT=8060

# Router port for Clients (the address book and Router management).
#ASPIA_ROUTER_CLIENT_PORT=8062

# Router's built-in STUN server: on/off and its UDP port.
#ASPIA_ROUTER_STUN_ENABLED=1
#ASPIA_ROUTER_STUN_PORT=8065

# ---------------------------------------------------------------------------------------------
# Router: address allow-lists
#
# Comma-separated IP addresses or CIDR subnets (e.g. "203.0.113.10,198.51.100.0/24"). Empty
# (the default) allows everyone. An entry that the Router itself later finds invalid is dropped
# with a warning in its own log; this image only checks that the list is well-formed.

#ASPIA_ROUTER_CLIENT_ALLOWED_IPS=
#ASPIA_ROUTER_HOST_ALLOWED_IPS=

# The Router's own co-located Relay always connects over 127.0.0.1: if you set this, it must
# include 127.0.0.1, or the container refuses to start (excluding it would lock out that Relay).
#ASPIA_ROUTER_RELAY_ALLOWED_IPS=127.0.0.1

# ---------------------------------------------------------------------------------------------
# Container-wide

# Run the Router and the Relay as this user/group id instead of root. Both must be set together,
# or both left unset. The container chowns ./data/config and ./data/database to this uid/gid on
# every start (it must therefore still start as root; do not combine this with "user:" in compose).
#PUID=1000
#PGID=1000

# Timezone for the Router's and the Relay's own log timestamps (IANA name, e.g. Europe/Berlin).
# Not used by this entrypoint's own log lines, which have no timestamp.
#TZ=UTC

# Minimum log level the Router and the Relay write: 0=TRACE 1=INFO (default) 2=WARNING 3=ERROR
# 4=FATAL. This is the binaries' own variable (ASPIA_LOG_LEVEL), passed straight through.
#ASPIA_LOG_LEVEL=1

# ---------------------------------------------------------------------------------------------
# Image (from PR 2; kept here for reference)

# Set to run a published image instead of building one locally, pinned to a version or a digest,
# e.g. ASPIA_IMAGE=ghcr.io/<owner>/aspia-server:3.0.21. Then use "docker compose pull" (no --build).
#ASPIA_IMAGE=
