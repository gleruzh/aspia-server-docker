# Aspia server (Router + Relay) as a Podman Quadlet unit. Setup, both install variants
# (system-wide and rootless), updating and troubleshooting: podman/README.md.
#
# Copy this file, aspia-server.env (from aspia-server.env.example), aspia-config.volume and
# aspia-data.volume to /etc/containers/systemd/ (as root) or ~/.config/containers/systemd/ (rootless),
# then: systemctl daemon-reload && systemctl start aspia-server.service
# (for rootless: systemctl --user ...).

[Unit]
Description=Aspia server (Router and Relay)
Wants=network-online.target
After=network-online.target

[Container]
# THE IMAGE: the one line to edit if you use a published image. The default is the name that
# "podman build -t aspia-server:3.0.21 ." gives (see podman/README.md). A published image lives
# under its publisher's name, e.g. ghcr.io/<owner>/aspia-server:3.0.21; set that here instead,
# or pin by digest: ghcr.io/<owner>/aspia-server@sha256:<digest>. Always an exact version, never
# latest. To update by hand: change the tag, systemctl daemon-reload, systemctl restart.
Image=localhost/aspia-server:3.0.21

ContainerName=aspia-server
EnvironmentFile=aspia-server.env

# Network: published ports, one-to-one (host port = container port), because the Relay tells
# clients its own port. If you change a port in aspia-server.env, change it here too.
# 8063 (Router <-> Relay) stays inside the container.
PublishPort=8060:8060/tcp
PublishPort=8061:8061/tcp
PublishPort=8062:8062/tcp
PublishPort=8065:8065/udp
PublishPort=8070:8070/tcp

# Configuration, keys and database. Named volumes, created by the .volume units next to this file.
Volume=aspia-config.volume:/etc/aspia
Volume=aspia-data.volume:/var/lib/aspia

# The health check is set here explicitly, so it does not depend on how the image was built or pulled.
HealthCmd=/usr/bin/aspia_health
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s

# No auto-update label on purpose: this project never updates a running container.

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=180

[Install]
WantedBy=default.target
