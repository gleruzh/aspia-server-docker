# Environment of the aspia-server Quadlet unit. Copy this file to aspia-server.env next to
# aspia-server.container, then uncomment and set what you need.
#
# Every variable, its default and its meaning: the table in the "Configuration" section of the
# main README.md (the same variables as .env.example, minus ASPIA_IMAGE: the image is the Image=
# line of the unit). Precedence is the same: a variable that is set is written to the
# configuration file on every start; an unset one leaves the file alone.
#
# Podman reads this file itself, not systemd, so: one VAR=value per line, no quotes (they would
# become part of the value), no trailing comments. Comment lines starting with # are fine.
#
# Ports: if you change a port variable below, change the matching PublishPort= line in
# aspia-server.container too (host port = container port), or use Network=host
# (podman/README.md, "Networking").

# Required: the public address the Relay announces (an IP, a host name or 'auto').
EXTERNAL_IP=203.0.113.10
#ASPIA_RELAY_PUBLIC_ADDRESS=203.0.113.10

#ASPIA_RELAY_PEER_PORT=8070
#ASPIA_RELAY_IDLE_TIMEOUT=5
#ASPIA_RELAY_MAX_PEERS=100

#ASPIA_ROUTER_HOST_PORT=8061
#ASPIA_ROUTER_LEGACY_PORT=8060
#ASPIA_ROUTER_CLIENT_PORT=8062
#ASPIA_ROUTER_STUN_ENABLED=1
#ASPIA_ROUTER_STUN_PORT=8065

#ASPIA_ROUTER_CLIENT_ALLOWED_IPS=
#ASPIA_ROUTER_HOST_ALLOWED_IPS=
#ASPIA_ROUTER_RELAY_ALLOWED_IPS=127.0.0.1

#PUID=1000
#PGID=1000
#TZ=UTC
#ASPIA_LOG_LEVEL=1
