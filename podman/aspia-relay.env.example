# Environment of the aspia-relay Quadlet unit (a Relay connected to a Router on another machine).
# Copy to aspia-relay.env next to aspia-relay.container and uncomment and set the three required lines. The
# variables are those of .env.example for a Relay (no ASPIA_ROUTER_*: they belong to the Router's
# host); same format rules as aspia-server.env (podman/README.md, section 6). ASPIA_ROLE=relay is set
# in the unit itself.

# Required: the Router's address as seen from this machine, and its relay key -- the content of the
# Router's /etc/aspia/relay.pub ("Public key for relays" in its log). Or ..._FILE instead of the key.
#ASPIA_RELAY_ROUTER_ADDRESS=router.example.com
#ASPIA_RELAY_ROUTER_PUBLIC_KEY=
#ASPIA_RELAY_ROUTER_PUBLIC_KEY_FILE=/run/aspia/router-relay.pub
#ASPIA_RELAY_ROUTER_PORT=8063

# Required: this Relay's public address, announced to clients and hosts (an IP, a host name or 'auto').
EXTERNAL_IP=203.0.113.20
#ASPIA_RELAY_PUBLIC_ADDRESS=203.0.113.20

#ASPIA_RELAY_PEER_PORT=8070
#ASPIA_RELAY_IDLE_TIMEOUT=5
#ASPIA_RELAY_MAX_PEERS=100

#PUID=1000
#PGID=1000
#TZ=UTC
#ASPIA_LOG_LEVEL=1
